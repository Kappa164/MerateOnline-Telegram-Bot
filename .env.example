# Copia questo file in .env e inserisci i valori veri.
# .env è escluso da git: non committarlo mai.

# Token del bot (da @BotFather)
BOT_TOKEN=1234567890:ABCDEF...

# Canale o chat: "@nome_canale" oppure l'ID numerico (da @MyIDBot)
CHANNEL_ID=-1001234567890

# Comune e pagina di merateonline.it da seguire
COMUNE=Merate
NEWS_URL=https://www.merateonline.it/articoli/l/56/merate

# true = resta in ascolto, false = invia le notizie una volta sola
SERVER_MODE=true

# Minuti tra una ricerca e l'altra
COOLDOWN=10
